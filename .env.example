# Copy this file to .env and fill in whichever providers you want to connect — any one
# works on its own, or all three together. Never commit your real .env (it's gitignored).
# You normally don't need to edit this file by hand — the in-app setup flow (npm start,
# then open http://localhost:4173) writes .env for you after verifying each key.

# Anthropic Admin API key (Claude Enterprise Analytics API). See:
# https://claude.ai/admin-settings/api-access
ANTHROPIC_ADMIN_KEY=sk-ant-admin-...

# OpenAI Admin API key (read-only). See:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=sk-...

# LiteLLM Proxy — your own company's self-hosted AI gateway. Use a proxy_admin_viewer-role
# key or one with the get_spend_routes permission — never the master key. This app only
# ever makes GET requests to /user/daily/activity.
LITELLM_BASE_URL=https://your-litellm-proxy.example.com
LITELLM_API_KEY=sk-...

# Optional: set to 1 to additionally expose a per-user email/id breakdown for LiteLLM spend
# (via /api/litellm-attribution). Off by default — team and key-alias level attribution is
# usually enough, and per-user spend can carry a real person's identity (GDPR data
# minimization). Only turn this on if you specifically need per-person numbers.
# LITELLM_INCLUDE_USER_BREAKDOWN=1
